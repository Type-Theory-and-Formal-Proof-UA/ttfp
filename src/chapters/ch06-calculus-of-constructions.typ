  #place(dx: 0cm, dy: 0cm, circle(radius: 1.4pt, fill: black))
  #place(dx: -0.62cm, dy: -0.18cm)[#lto]
  #place(dx: -0.62cm, dy: 2.45cm)[до #ltwo]
  #place(dx: 2.05cm, dy: 2.45cm)[до #lomega]
  #place(dx: 3.2cm, dy: -0.62cm)[до #lp]
