#import "/book.typ": *

// Прапорцевий стовпчик розділу 14 (той самий засіб, що й у частині 1).
#let c14flag(depth, body) = {
  let b = body
  for _ in range(depth) {
    b = box(stroke: (left: 0.6pt), inset: (left: 7pt), b)
  }
  b
}

== Замкненість відносно додавання для натуральних і від'ємних чисел

Тепер ми зосередимося на важливій властивості додавання для елементів підмножини
$NN$, а саме на тій гарній властивості, що $NN$ замкнена відносно додавання;
тобто:

#lemma(name: [Замкненість $NN$ відносно додавання])[
  $forall x, y : ZZ . ((x epsilon NN and y epsilon NN) arrow.r.double x + y epsilon NN).$
]

#proof[
  Доведення — за індукцією для натуральних чисел (nat-ind; див. рисунок 14.8). Ми
  беремо $x$ фіксованим і застосовуємо індукцію за $y$. Тому спершу
  переформулюймо лему 14.7.1 так, щоб полегшити індукцію (перевірте, що ці два
  вирази еквівалентні):

  Довести: $forall x : ZZ . (x epsilon NN arrow.r.double forall y : ZZ . (y epsilon NN arrow.r.double x + y epsilon NN))$.

  Отже, візьмімо $x$ типу $ZZ$ фіксованим і припустімо $x epsilon NN$. Довести:

  $forall y : ZZ . (y epsilon NN arrow.r.double x + y epsilon NN)$.

  Для доведення індукцією за $y$ розгляньмо відповідний предикат індукції, а саме
  $P := lambda y : ZZ . (x + y epsilon NN)$.

  Тепер ми отримуємо:

  #enum(
    numbering: "(1)",
    [$P 0$, оскільки $x + 0 = x$ і $x epsilon NN$ за припущенням.],
    [Нехай $y : ZZ$ таке, що $y epsilon NN$ і $P y$. Довести: $P(s y)$. Тепер $P y$
      означає $x + y epsilon NN$; тоді також $s(x + y) epsilon NN$ за clos-prop
      (рисунок 14.5), отже $x + s y epsilon NN$, що і є $P(s y)$.

      Отже, $forall y : ZZ . (y epsilon NN arrow.r.double (P y arrow.r.double P(s y)))$.],
  )

  За nat-ind ми можемо зробити висновок, що $forall y : ZZ . (y epsilon NN arrow.r.double P y)$,
  як і бажано.
]

Ми формалізуємо це доведення та його висновок на рисунку 14.15, у стилі, до якого
ми вже звикли: багато об'єктів доведення насправді не подано, а лише натякнуто на
них. Зауважте, що $P$ залежить від «фіксованого» $x$: список параметрів, $(x)$,
пригнічено відповідно до позначення 11.7.1.

#figure(
  numbering: none,
  box(stroke: none, inset: 6pt)[
    #grid(
      columns: (auto, 1fr),
      column-gutter: 0.8em,
      row-gutter: 0.45em,
      align: (right + horizon, left + horizon),
      [], [$#c14flag(0)[$x : ZZ$]$],
      [$(1)$], [#c14flag(1)[$P^dagger := lambda y : ZZ . (x + y epsilon NN) : ZZ -> ast_p$]],
      [], [#c14flag(1)[$u : x epsilon NN$]],
      [$(2)$], [#c14flag(2)[$a_2 := dots.c "вжийте" "plus-i" "та" "eq-sym" dots.c : x = x + 0$]],
      [$(3)$], [#c14flag(2)[$a_3 := dots.c "вжийте" "eq-subs на" a_2 "та" u dots.c : P 0$]],
      [], [#c14flag(3)[$y : ZZ | v : y epsilon NN$]],
      [], [#c14flag(4)[$w : P y$]],
      [$(4)$], [#c14flag(4)[$a_4 := "clos-prop" (x + y) w : s(x + y) epsilon NN$]],
      [$(5)$], [#c14flag(4)[$a_5 := dots.c "вжийте" "plus-ii та eq-sym" dots.c : s(x + y) = x + s y$]],
      [$(6)$], [#c14flag(4)[$a_6 := dots.c "вжийте" "eq-subs на" a_5 "та" a_4 dots.c : P(s y)$]],
      [$(7)$], [#c14flag(3)[$a_7 := dots.c "вжийте" arrow.r.double "-in двічі та" forall "-in на" a_6 dots.c : forall y : ZZ . (y epsilon NN arrow.r.double (P y arrow.r.double P(s y)))$]],
      [$(8)$], [#c14flag(2)[$a_8 := dots.c "вжийте" and "-in на" a_3 "та" a_7 ", і" arrow.r.double "-el на" "nat-ind"(P) dots.c : forall y : ZZ . (y epsilon NN arrow.r.double x + y epsilon NN)$]],
      [$(9)$], [$a_9 := dots.c "вжийте" arrow.r.double "-in та" forall "-in на" a_8 dots.c : forall x : ZZ . (x epsilon NN arrow.r.double forall y : ZZ . (y epsilon NN arrow.r.double x + y epsilon NN))$],
      [], [$x, y : ZZ | u : x epsilon NN | v : y epsilon NN$],
      [$(10)$], [#c14flag(1)[$"plus-clos-nat" := a_9 x u y v : x + y epsilon NN$]],
