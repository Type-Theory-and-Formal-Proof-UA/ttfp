      [$(13)$], [#c15flag(1)[$a_(13) := "min-prop"(S^+, a_(10), a_(11)) : d epsilon S^+ and "lw-bnd"_ZZ (S^+, d)$]],
      [$(14)$], [#c15flag(1)[$a_(14) := dots.c "вжити" "∧-вил 1 до" a_(13) dots.c : d epsilon S and d epsilon NN^+$]],
      [$(15)$], [#c15flag(1)[$a_(15) := dots.c "вжити" "∧-вил 1 до" a_(14) dots.c : d epsilon S$]],
      [$(16)$], [#c15flag(1)[$a_(16) := a_(15) : exists x_0, y_0 : ZZ . (d = m dot x_0 + n dot y_0)$]],
      [$(17)$], [#c15flag(1)[$a_(17) := dots.c "вжити" "∧-вил 2 до" a_(14) dots.c : d > 0$]],
      [$(18)$], [#c15flag(1)[$a_(18) := dots.c "вжити" "∧-вил 2 до" a_(13) dots.c : forall x : ZZ . (x epsilon S^+ arrow.r.double d lt.eq x)$]],
    )
  ],
