      [], [$#c14flag(0)[$m : ZZ$]$],
      [$(2)$], [#c14flag(1)[$"rec-add-prop"(m) := lambda g : ZZ -> ZZ . (g 0 =_(ZZ) m and forall x : ZZ . (g(s x) =_(ZZ) s(g x))) : (ZZ -> ZZ) -> ast_p$]],
