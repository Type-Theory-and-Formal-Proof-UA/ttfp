  kind: "ris",
  supplement: [Рисунок],
  numbering: none,
  align(center)[
    #table(
      columns: (2.2em,) * 7,
      align: center + horizon,
      stroke: none,
      inset: 0pt,
      [], [], [], $a$, [], [], [],
      [], [], [╱], [], [╲], [], [],
      [], [], [$y$], [], [$lambda x$], [], [],
      [], [], [], [], [│], [], [],
      [], [], [], [], [$a$], [], [],
      [], [], [], [╱], [], [╲], [],
