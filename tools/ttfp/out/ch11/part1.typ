      ([(1)], 4, [$a_1^† := or "-in"_1 (A, B, w) : A or B$]),
      ([(2)], 4, [$a_2 := v a_1 : bot$]),
      ([(3)], 3, [$a_3 := lambda w : A . a_2 : not A$]),
      ([(e)], 3, [$w : B$]),
      ([(4)], 4, [$a_4 := or "-in"_2 (A, B, w) : A or B$]),
      ([(5)], 4, [$a_5 := v a_4 : bot$]),
      ([(6)], 3, [$a_6 := lambda w : B . a_5 : not B$]),
      ([(7)], 3, [$a_7 := u a_3 : B$]),
      ([(8)], 3, [$a_8 := a_6 a_7 : bot$]),
      ([(9)], 2, [$a_9 := lambda v : not(A or B) . a_8 : not not(A or B)$]),
      ([(10)], 2, [$a_(10) := not not "-el"(A or B, a_9) : A or B$]),
      ([(11)], 1, [$a_(11) := lambda u : (not A arrow.r.double B) . a_(10) : (not A arrow.r.double B) arrow.r.double (A or B)$]),
