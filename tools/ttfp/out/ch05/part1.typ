// Допоміжний засіб для прапорцевих виведень: `#ch05flag(depth, boxed: ...)`
// малює вертикальне «древко» прапорця для кожного рівня вкладеності.
#let ch05flag(depth, boxed: false, body) = {
  let b = if boxed { box(stroke: 0.5pt, inset: (x: 5pt, y: 3pt), body) } else { body }
