      [], [$#c14flag(0)[$x : ZZ$]$],
      [$(3)$], [#c14flag(1)[$"pos"(x) := p x epsilon NN$]],
      [$(4)$], [#c14flag(1)[$"neg"(x) := not (x epsilon NN)$]],
