      [$(7)$], [#c14flag(2)[$"gcd-pos"(m, n, s, t) := dots.c : "gcd"(m, n, s, t) gt 0$]],
    )
  ],
  caption: [Рисунок 14.23. Поняття, споріднені з подільністю],
