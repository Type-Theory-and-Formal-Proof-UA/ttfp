      columns: (auto, 1fr),
      column-gutter: 0.8em,
      row-gutter: 0.5em,
      [$dots.h.c$], [],
      [$dots.h.c$], [],
      [$(c)$], flag(1)[$u : "partially-ordered"(S, R)$],
      [$(d)$], flag(2)[$m : S$],
      [$(5)$], flag(3)[$"minimal-element"(S, R, u, m) := forall x in S (R(x, m) arrow.r.double x = m) : ast$],
    )
  ],
  caption: [Рисунок 8.3. Означення «мінімальний елемент», залежне від припущення],
