      [$(4)$], [#c14flag(1)[$"rec-mult-lem"(m) := dots.c "скористайтеся теоремою 14.4.5" dots.c : exists_1 g : ZZ -> ZZ . ("rec-mult-prop"(m) g)$]],
      [$(5)$], [#c14flag(1)[$"times"(m) := iota(ZZ -> ZZ, "rec-mult-prop"(m), "rec-mult-lem"(m)) : ZZ -> ZZ$]],
