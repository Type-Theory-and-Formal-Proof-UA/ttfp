      [$(36)$], [#c15flag(1)[$a_(36) := dots.c "вжити" "∃-вил" "до" a_(19) dots.c : d divides m$]],
      [$(37)$], [#c15flag(1)[$a_(37) := dots.c "вжити" "∃-вил" "до" a_(16) dots.c : d divides m$]],
    )
  ],
  caption: [Рисунок 15.12. Крок 8 доведення],
