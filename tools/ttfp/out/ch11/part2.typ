#import "/book.typ": *

// Допоміжні засоби для прапорцевих виведень цього розділу (як у розділах 12 і 15):
// `ch11flag(depth, body)` загортає `body` у `depth` древків прапорців.
#let ch11flag(depth, body) = {
  let b = body
  for _ in range(depth) {
    b = box(stroke: (left: 0.6pt), inset: (left: 7pt), b)
  }
  b
}
// Рядки прапорцевого виведення: список трійок (номер, глибина, вміст).
#let ch11rows(rows) = rows.map(r => (r.at(0), ch11flag(r.at(1), r.at(2)))).flatten()
// Правило виведення з назвою зліва: засновки над рискою, висновок під нею.
#let ch11rule(name, premis, concl) = table(
  columns: (auto, auto),
  stroke: none,
  align: (right + horizon, center + horizon),
  column-gutter: 1.2em,
  [#name],
  table(
    columns: 1,
    stroke: none,
    align: center,
    if premis.len() == 1 {
      box(premis.at(0))
    } else {
      grid(
        columns: (auto,) * premis.len(),
        stroke: none,
        align: center,
        column-gutter: 1.1em,
        ..premis.map(box),
      )
    },
    table.cell(
      stroke: (top: 0.6pt),
      inset: (top: 5pt, x: 3pt, y: 2pt),
      align: center,
    )[#box(concl)],
  ),
)

== Правила для конструктивної логіки предикатів

Логіка предикатів — це логіка, яку отримуємо, розширивши логіку висловлювань
кванторами $forall$ та $exists$. Почнімо з конструктивних правил для універсального
квантора $forall$.

Як ми вже обговорювали в підрозділі 5.4, V, вираз $forall x in S (P(x))$ природно
кодується як $Pi x : S . P x$ у теорії типів. Це дає змогу легко з'ясувати, якими
стають правила введення та вилучення для $forall$ у #ld (див. рисунок 11.22). Для
ясності викладу ми пишемо $ast$ як або $ast_s$ (коли маємо справу з множинами), або
$ast_p$ (для висловлювань); див. позначення 8.7.1.

#figure(
  align(center)[#text(size: 9.5pt)[
    #table(
      columns: (auto, 1fr),
      stroke: none,
      align: (right + horizon, left + horizon),
      column-gutter: 0.9em,
      row-gutter: 0.45em,
      ..ch11rows((
        ([], 0, [$S : ast_s$ | $P : S -> ast_p$]),
        ([(1)], 0, [$forall(S, P) := Pi x : S . P x : ast_p$]),
        ([], 1, [Позначення: $forall x : S . P x$ замість $forall(S, P)$]),
        ([], 1, [$u : Pi x : S . P x$]),
        ([(2)], 1, [$forall"-in"(S, P, u) := u : forall x : S . P x$]),
        ([], 0, [$u : forall x : S . P x$ | $v : S$]),
        ([(3)], 1, [$forall"-el"(S, P, u, v) := u v : P v$]),
      )),
    )
  ]],
  numbering: none,
  caption: [Рисунок 11.22. Означення та правила для $forall$],
)

#remark[
  Ми формулюємо $forall$-правила лише в першопорядковому випадку, коли $x$ пробігає
  множину $S$, бо це стандартна ситуація. Подібні правила можна розробити й для
  другопорядкового випадку, коли змінна пробігає, наприклад, висловлювання. Така
  ситуація трапляється, приміром, у раніше згаданих другопорядкових означеннях, як-от
  $bot := Pi A : ast_p . A : ast_p$ (див. підрозділ 11.5).

  У підрозділі 11.5 ми зауважили, що версії правил натурального виведення для
  $arrow.r.double$, $bot$ і $not$ у #ld ми вживаємо лише ощадливо, оскільки
  теоретико-типовий стиль дає коротші об'єкти доведень. Те саме стосується
  $forall$-правил: ми застосовуємо правила, означені вище, лише тоді, коли хочемо
  підкреслити, що відбувається $forall$-введення чи $forall$-вилучення. Отже,
  побудовані об'єкти доведень у цих випадках зазвичай подаються в теоретико-типовому
  стилі, тобто $u$ замість $forall"-in"(S, P, u)$ і $u v$ замість
  $forall"-el"(S, P, u, v)$.
]

Ми продовжуємо конструктивними правилами для екзистенційного квантора $exists$.
Відповідні правила натурального виведення обговорюються в підрозділі 7.5 разом із
їхніми перекладами в #lc.

Нижче ми підсумовуємо ці результати, але тепер уже в #ld. Ми вживаємо
другопорядкове означення $exists$, яке повторюємо (з незначними пристосуваннями) у
рядку (1). Об'єкт доведення в рядку (2) знайти легко; див. вправу 7.12 (a). Об'єкт
доведення в рядку (3) було виведено в підрозділі 7.5.

#figure(
  align(center)[#text(size: 9.5pt)[
    #table(
      columns: (auto, 1fr),
      stroke: none,
      align: (right + horizon, left + horizon),
      column-gutter: 0.9em,
      row-gutter: 0.45em,
      ..ch11rows((
        ([], 0, [$S : ast_s$ | $P : S -> ast_p$]),
        ([(1)], 0, [$exists(S, P) := Pi A : ast_p . ((forall x : S . (P x arrow.r.double A)) arrow.r.double A) : ast_p$]),
        ([], 1, [Позначення: $exists x : S . P x$ замість $exists(S, P)$]),
        ([], 0, [$u : S$ | $v : P u$]),
        ([(2)], 1, [$exists"-in"(S, P, u, v) := lambda A : ast_p . lambda w : (forall x : S . (P x arrow.r.double A)) . w u v : exists x : S . P x$]),
        ([], 0, [$u : exists x : S . P x$ | $A : ast_p$ | $v : forall x : S . (P x arrow.r.double A)$]),
        ([(3)], 1, [$exists"-el"(S, P, u, A, v) := u A v : A$]),
      )),
    )
  ]],
  numbering: none,
  caption: [Рисунок 11.23. Означення та правила для $exists$],
)

Уживання правила $exists$-введення буде очевидним: щоб установити, що
$exists x : S . P x$, достатньо знайти $u$ в $S$, яке задовольняє $P$. Саме це й
підказує цей вираз. Правило $exists$-вилучення складніше. Його обґрунтування див. у
підрозділі 7.5. Зауважте, що п'ять припущень у рядку (3) утворюють правильно
побудований контекст. Це означає, що $x$ не трапляється як вільна змінна в $A$, як
цього вимагає підрозділ 7.5.

Правило $exists$-вилучення з рисунка 11.23 зазвичай уживають так.

Припустімо, що ми займаємося побудовою виведення і що панівною метою є висловлювання
$A$, а ми виявили, що $exists x : S . P x$ — це придатний факт. Щоб заповнити
прогалину між $exists x : S . P x$ і $A$, правило $exists"-el"$ підказує нам знайти
мешканця $forall x : S . (P x arrow.r.double A)$ (який стає новою метою). Природна
стратегія для цього — припустити $x : S$ і $P x$ та знайти мешканця $A$. Зауважте,
що це та сама мета $A$, що й раніше, але тепер у контексті, розширеному двома
згаданими додатковими припущеннями. Якщо нам вдасться виконати це завдання, то
$exists"-el"$ дасть змогу зробити висновок про початкову мету $A$.

Схематичне зображення цієї стратегії в теорії типів таке:

#align(center)[#text(size: 9.5pt)[
  #table(
    columns: (auto, 1fr),
    stroke: none,
    align: (right + horizon, left + horizon),
    column-gutter: 0.9em,
    row-gutter: 0.45em,
    ..ch11rows((
      ([], 0, [$dots.v$]),
      ([], 0, [$a(dots) := dots : exists x : S . P x$]),
      ([], 1, [$x : S$]),
      ([], 2, [$u : P x$]),
      ([], 3, [$dots.v$]),
      ([], 3, [$b(dots, x, u) := dots : A$]),
      ([], 1, [$c(dots, x) := lambda u : P x . b(dots, x, u) : P x arrow.r.double A$]),
      ([], 0, [$d(dots) := lambda x : S . c(dots, x) : forall x : S . (P x arrow.r.double A)$]),
      ([], 0, [$e(dots) := exists"-el"(S, P, a(dots), A, d(dots)) : A$]),
    )),
  )
]]

Далі наведемо приклад, у якому відіграють роль і $exists$-in, і $exists$-el, і для
якого у вправі 7.13 вимагалося виведення в #lc. Див. рисунок 11.24. Лема, яку ми
доводимо, така:

#align(center)[
  $exists x : S . P x arrow.r.double forall y : S . (P y arrow.r.double Q y) arrow.r.double exists z : S . Q z .$
]

У цьому виведенні прапорці $x : S$ і $w : P x$ піднято, оскільки ми маємо мешканця
(а саме $u$) виразу $exists x : S . P x$. Це узгоджується зі схематичним зображенням
стратегії $exists$-вилучення, щойно наведеним. Перевірте подробиці.

#figure(
  align(center)[#text(size: 9.5pt)[
    #table(
      columns: (auto, 1fr),
      stroke: none,
      align: (right + horizon, left + horizon),
      column-gutter: 0.9em,
      row-gutter: 0.45em,
      ..ch11rows((
        ([], 0, [$S : ast_s$ | $P : S -> ast_p$ | $Q : S -> ast_p$]),
        ([], 1, [$u : exists x : S . P x$ | $v : forall y : S . (P y arrow.r.double Q y)$]),
        ([], 2, [$x : S$ | $w : P x$]),
        ([(1)], 3, [$a_1^† := v x : P x arrow.r.double Q x$]),
        ([(2)], 3, [$a_2 := a_1 w : Q x$]),
        ([(3)], 3, [$a_3 := exists"-in"(S, Q, x, a_2) : exists z : S . Q z$]),
        ([(4)], 2, [$a_4 := lambda x : S . lambda w : P x . a_3 : forall x : S . (P x arrow.r.double exists z : S . Q z)$]),
        ([(5)], 1, [$a_5 := exists"-el"(S, P, u, exists z : S . Q z, a_4) : exists z : S . Q z$]),
        ([(6)], 0, [$a_6 (S, P, Q) := lambda u : (exists x : S . P x) . lambda v : (forall y : S . (P y arrow.r.double Q y)) . a_5 : exists x : S . P x arrow.r.double forall y : S . (P y arrow.r.double Q y) arrow.r.double exists z : S . Q z$]),
        ([], 0, [$†$ #text(size: 8pt)[параметри придушено]]),
      )),
    )
  ]],
  numbering: none,
  caption: [Рисунок 11.24. Приклад, що стосується правил для $exists$],
)

#remark[
  Два припущення в другому прапорці, а саме $exists x : S . P x$ і
  $forall y : S . (P y arrow.r.double Q y)$, не узгоджуються з правилом
  $exists"-el"$: хоч і здається спокусливим зробити з цього правила висновок $Q y$,
  це неправильно, оскільки $y$ трапляється вільно в $Q y$. Див. зауваження 7.5.2.
]

Як ще один приклад розгляньмо таке відоме твердження:

#align(center)[
  $exists x in S (P(x)) arrow.r.double not forall x in S (not P(x)) .$
]

У виведенні цього твердження в #ld правило $exists"-el"$ можна застосувати
безпосередньо: див. рисунок 11.25.

#figure(
  align(center)[#text(size: 9.5pt)[
    #table(
      columns: (auto, 1fr),
      stroke: none,
      align: (right + horizon, left + horizon),
      column-gutter: 0.9em,
      row-gutter: 0.45em,
      ..ch11rows((
        ([], 0, [$S : ast_s$ | $P : S -> ast_p$]),
        ([], 1, [$u : exists x : S . P x$]),
        ([], 2, [$v : forall y : S . not(P y)$]),
        ([(1)], 3, [$a_1^† := exists"-el"(S, P, u, bot, v) : bot$]),
        ([(2)], 2, [$a_2 := lambda v : (forall y : S . not(P y)) . a_1 : not forall y : S . not(P y)$]),
        ([(3)], 1, [$a_3 (S, P) := lambda u : (exists x : S . P x) . a_2 : (exists x : S . P x) arrow.r.double not(forall y : S . not(P y))$]),
        ([], 0, [$†$ #text(size: 8pt)[параметри придушено]]),
      )),
    )
  ]],
  numbering: none,
  caption: [Рисунок 11.25. Приклад: $exists$ тягне $not forall not$],
)

Готуючи це виведення, ми маємо в розпорядженні $exists x : S . P x$ в одному з
прапорців. Тож коли ми хочемо застосувати $exists$-вилучення, маючи за мету $bot$ у
рядку (1), нам треба вивести мешканця $forall x : S . (P x arrow.r.double bot)$. Але
такий мешканець уже напохваті, а саме $v$ в останньому прапорці, бо $not P y$
еквівалентне до $P y arrow.r.double bot$.

Решта виведення говорить сама за себе.

== Правила для класичної логіки предикатів

Коли ми поєднуємо правила введення та вилучення для кванторів із конструктивною
логікою висловлювань, то отримуємо конструктивну логіку предикатів. У цій системі,
подібно до ситуації з конструктивною логікою висловлювань, нам бракує деяких
тавтологій із кванторами, які математики інтуїтивно вважають істинними. Прикладом є
обернення останнього прикладу з попереднього підрозділу, а саме:

#align(center)[
  $not forall x in S (not P(x)) arrow.r.double exists x in S (P(x)) .$
]

Цей вираз природно вважати істинним, бо він каже: «Якщо не всі елементи $S$ не
задовольняють $P$, то мусить існувати елемент $S$, який їх задовольняє». Але його не
можна вивести в (першо- чи другопорядковому) конструктивному численні предикатів.

Додавши аксіому висловлювань DN (або ET), ми отримуємо класичну логіку предикатів, у
якій наведений вираз можна вивести, як ми покажемо нижче. Як наслідок, ми можемо
об'єднати ці два твердження в класичний факт логіки предикатів (у скороченні):
$exists arrow.l.r.double not forall not$.

#remark[
  Існує відповідник до згаданої вище еквівалентності
  $exists arrow.l.r.double not forall not$, який полягає в тому, що також
  $forall arrow.l.r.double not exists not$ чинне в класичній логіці предикатів. Це
  залишаємо читачеві (вправа 11.16; див. також вправу 7.12 (b)).
]

У доведенні ми добре скористаємося ще однією простою еквівалентністю щодо кванторів,
яка допускає конструктивне доведення:

#align(center)[
  $not exists x in S (P(x)) arrow.r.double forall x in S (not P(x)) .$
]

Спершу наведемо виведення цього останнього твердження (рисунок 11.26), а потім —
першого (рисунок 11.27).

Для останнього згаданого твердження ми вже давали доведення в #lc (див. підрозділ
7.6). Але там ми ще не мали формального апарату означень. Виведення на рисунку 11.26
дає читачеві змогу порівняти підхід #lc і підхід #ld до формальної розробки доведень.
Це проста вправа з натурального виведення. Зауважимо лише, що мету $bot$ у рядку (2)
легко вивести з припущення $not exists x : S . P x$ та з того факту, що $y : S$ і
$v : P y$ спричиняють $exists z : S . P z$ (рядок (1)). Решта — рутина.

#figure(
  align(center)[#text(size: 9.5pt)[
    #table(
      columns: (auto, 1fr),
      stroke: none,
      align: (right + horizon, left + horizon),
      column-gutter: 0.9em,
      row-gutter: 0.45em,
      ..ch11rows((
        ([], 0, [$S : ast_s$ | $P : S -> ast_p$]),
        ([], 1, [$u : not exists x : S . P x$]),
        ([], 2, [$y : S$]),
        ([], 3, [$v : P y$]),
        ([(1)], 4, [$a_1^† := exists"-in"(S, P, y, v) : exists z : S . P z$]),
        ([(2)], 4, [$a_2 := u a_1 : bot$]),
        ([(3)], 3, [$a_3 := lambda v : P y . a_2 : not(P y)$]),
        ([(4)], 2, [$a_4 := lambda y : S . a_3 : forall y : S . not(P y)$]),
        ([(5)], 1, [$a_5 (S, P) := lambda u : (not exists x : S . P x) . a_4 : (not exists x : S . P x) arrow.r.double forall y : S . not(P y)$]),
        ([], 0, [$†$ #text(size: 8pt)[параметри придушено]]),
      )),
    )
  ]],
  numbering: none,
  caption: [Рисунок 11.26. Приклад: $not exists$ тягне $forall not$],
)

Виведення на рисунку 11.27 є наслідком: воно використовує рядок (4) рисунка 11.26.
Ми застосовуємо метод доведення від супротивного (див. зауваження 11.8.1),
додаючи прапорець $v : not exists y : S . P y$, щоб отримати
$exists y : S . P y$ у рядку (4) через рядок (3) і $not not"-el"$. Нагадаємо, що
$not not"-el"$ ґрунтується на аксіомі DN, отже, це виведення неконструктивне.

У класичній логіці предикатів виявляється вигідним додати альтернативні правила для
$exists$, натхненні еквівалентністю $exists$ і $not forall not$, яку ми встановили
вище.

Мотивація додавання цих альтернативних правил подібна до ситуації з диз'юнкцією
(пор. підрозділ 11.9). У практичному пошуку доведень конструктивне
правило $exists"-in"$ виявляється досить обмежувальним, так само як і $or"-in"$:
щоб отримати доведення $exists x : S . P x$, процедура, яку підказує $exists"-in"$,
полягає в тому, щоб знайти так званого «свідка», тобто певну сутність $a$ типу $S$,
яка задовольняє $P$. Але існування $x$, що задовольняє $P x$, не завжди означає, що
ми можемо вказати свідка.

#figure(
  align(center)[#text(size: 9.5pt)[
    #table(
      columns: (auto, 1fr),
      stroke: none,
      align: (right + horizon, left + horizon),
      column-gutter: 0.9em,
      row-gutter: 0.45em,
      ..ch11rows((
        ([], 0, [$S : ast_s$ | $P : S -> ast_p$]),
        ([], 1, [$u : not forall x : S . not(P x)$]),
        ([], 2, [$v : not exists y : S . P y$]),
        ([(1)], 3, [$a_1^† := a_4^("Рис. 11.26")(S, P, v) : forall z : S . not(P z)$]),
        ([(2)], 3, [$a_2 := u a_1 : bot$]),
        ([(3)], 2, [$a_3 := lambda v : (not exists y : S . P y) . a_2 : not not exists y : S . P y$]),
        ([(4)], 2, [$a_4 := not not"-el"(exists y : S . P y, a_3) : exists y : S . P y$]),
        ([(5)], 1, [$a_5 (S, P) := lambda u : (not forall x : S . not(P x)) . a_4 : not forall x : S . not(P x) arrow.r.double exists y : S . P y$]),
        ([], 0, [$†$ #text(size: 8pt)[параметри придушено]]),
      )),
    )
  ]],
  numbering: none,
  caption: [Рисунок 11.27. Приклад: $not forall not$ тягне $exists$],
)

У класичній логіці ми можемо вивести $exists x : S . P x$ без свідка, якщо можемо
довести $not forall x : S . not(P x)$, що й демонструє рисунок 11.27.

З міркувань симетрії ми також додаємо альтернативне правило $exists"-el"$, яке веде
(в інший бік) від $exists$ до $not forall not$. Це правило ґрунтується на
конструктивному прикладі-виведенні з рисунка 11.25, у якому вжито початкове
$exists"-el"$.

Обидва альтернативні правила для $exists$ подано на рисунку 11.28.

