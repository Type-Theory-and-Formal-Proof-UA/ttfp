#exercise[
  Означимо λ-терми $"zero"$, $"one"$, $"two"$ (перші три так звані числа Черча) і λ-терми $"add"$ та $"mult"$ (які імітують додавання й множення чисел Черча) так:
  $ & "zero" := lambda f x . x , \
    & "one" := lambda f x . f x , \
    & "two" := lambda f x . f (f x) , \
    & "add" := lambda m n f x . m f (n f x) , \
    & "mult" := lambda m n f x . m(n f)x . $
  #enum(
    numbering: "(a)",
    [Покажіть, що $"add" "one" "one" arrow.r.long_beta "two"$.],
    [Доведіть, що $"add" "one" "one" eq.not_(beta) "mult" "one" "zero"$.],
  )
]

#exercise[
