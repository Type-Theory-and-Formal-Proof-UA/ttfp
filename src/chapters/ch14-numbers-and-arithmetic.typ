      [], [$#c14flag(0)[$x : ZZ$]$],
      [$(2)$], [#c14flag(1)[$"times-i"(x) := dots.c : x dot 0 = 0$]],
      [], [#c14flag(1)[$y : ZZ$]],
      [$(3)$], [#c14flag(2)[$"times-ii"(x, y) := dots.c : x dot s y = (x dot y) + x$]],
